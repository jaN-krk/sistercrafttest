# Configure these server-only values in Vercel. Never commit credentials.
APP_ORIGIN=https://sistercrafttest.vercel.app
IYZICO_MODE=live
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_VERIFIED=false
ADMIN_EMAILS=
# Owner-only first registration only. Must be false before public access/payment.
ADMIN_BOOTSTRAP_PRIVATE=false
RESEND_API_KEY=
EMAIL_FROM=

# Initial admin credential hash only; never put the plaintext password here.
ADMIN_LOGIN_USER=
ADMIN_PASSWORD_HASH=

# Vercel Marketplace integrations provision these automatically.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
BLOB_STORE_ID=
# Optional alternate Blob authentication outside Vercel OIDC.
BLOB_READ_WRITE_TOKEN=
STORE_NOTIFICATION_EMAIL=ebr.krgl@gmail.com

# MailerSend Sandbox: use the sender address shown in its dashboard.
EMAIL_PROVIDER=mailersend
MAILERSEND_API_KEY=
EMAIL_TEST_MODE=true
EMAIL_TEST_RECIPIENTS=ebr.krgl@gmail.com
